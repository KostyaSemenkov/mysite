{$DOMAIN} {
	encode gzip

	# приложение «Доски»: всё под /boards уходит в boards-сервис,
	# префикс срезается (handle_path) — WS, API и статику обслуживает FastAPI
	handle_path /boards/* {
		reverse_proxy boards:8000
	}

	handle /media/* {
		uri strip_prefix /media
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}
