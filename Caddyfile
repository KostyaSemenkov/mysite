{$DOMAIN} {
	encode gzip

	# браузер всегда ходит на сайт по HTTPS и не даёт перейти по http в обход
	# предупреждений о сертификате. Без includeSubDomains: на поддоменах могут быть
	# другие сервисы, и если у них нет HTTPS, они станут недоступны.
	header Strict-Transport-Security "max-age=31536000"

	# приложение «Доски»: всё под /boards уходит в boards-сервис,
	# префикс срезается (handle_path) — WS, API и статику обслуживает FastAPI.
	# Заголовки безопасности сайт отдаёт из Django, «Доски» — из своего main.py.
	handle_path /boards/* {
		reverse_proxy boards:8000
	}

	handle /media/* {
		uri strip_prefix /media
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}
